{
  "profiles": [
    {
      "name": "Demo setup (Full multi-agent remote config)",
      "scenario_description": "Runs Fluent Bit and Fluentd in supervisor mode, attaches Vector, Elastic Agent, and Elastic Heartbeat in observer mode, and starts a Logstash container for Elastic output.",
      "fluentbit": {
        "config_path": "demos/full_multi_agent/consumers/opamp-fluent-bit.json"
      },
      "fluentd": {
        "config_path": "demos/full_multi_agent/consumers/opamp-fluentd.json"
      },
      "vector": {
        "config_path": "demos/full_multi_agent/consumers/opamp-vector.json"
      },
      "elastic_agent": {
        "config_path": "demos/full_multi_agent/consumers/opamp-elastic-agent.json"
      },
      "elastic_heartbeat": {
        "config_path": "demos/full_multi_agent/consumers/opamp-heartbeat.json"
      },
      "containers": [
        {
          "id": "logstash-full-demo",
          "label": "Logstash full demo pipeline",
          "container_name": "opamp-logstash-full-demo",
          "replace_existing": true,
          "image_candidates": [
            "docker.elastic.co/logstash/logstash:9.5.1",
            "logstash:9.5.1"
          ],
          "ports": [
            "127.0.0.1:5044:5044"
          ],
          "volumes": [
            {
              "host_path": "demos/full_multi_agent/logstash/logstash.container.conf",
              "container_path": "/usr/share/logstash/pipeline/logstash.conf",
              "read_only": true
            },
            {
              "host_path": "demos/full_multi_agent/out/logstash",
              "container_path": "/usr/share/logstash/out"
            }
          ],
          "ensure_dirs": [
            "demos/full_multi_agent/out/logstash"
          ],
          "command": [
            "logstash",
            "-f",
            "/usr/share/logstash/pipeline/logstash.conf"
          ],
          "aliases": [
            "logstash-full-demo",
            "full demo logstash"
          ]
        }
      ]
    }
  ]
}
